# --- Meta Model API (primary) ---
# VII is online-first: without MODEL_API_KEY, provider-backed analysis fails
# with ProviderConfigurationError. Synthetic demo requires explicit opt-in
# (VII_DEMO_MODE=true) and is never a fallback.
MODEL_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3
META_TRANSCRIPTION_MODEL=muse-voice-transcribe-1.0

# --- App ---
VII_DEMO_MODE=false
VII_OFFLINE_MODE=false
VII_DATABASE_URL=sqlite:///./data/vii.db
VII_STORAGE_DIR=./data
# Default folder the TUI chatbot offers videos from (blank = ~/Downloads).
VII_MEDIA_DIR=
VII_MAX_UPLOAD_MB=512
VII_MAX_VIDEO_SECONDS=3600
VII_FFMPEG_BIN=ffmpeg
VII_FFPROBE_BIN=ffprobe
VII_SEARCH_CONTEXT_SIZE=medium
# Separate transcription stage (FFmpeg audio extraction + transcription
# model). Set false when the native video path already covers the audio
# you need; skipping is logged in the job, never silent.
VII_ENABLE_TRANSCRIPTION=true
# Visual perception: disabled by default. Provider options:
#   local — working local provider (FFmpeg-sampled frames + Pillow frame
#           analysis; status available_local; no masks/tracking/prompts)
#   sam   — SAM 3.1 adapter (docs-verified contract: model sam-3.1,
#           POST /v1/responses, same Bearer key as MODEL_API_KEY unless
#           VII_SAM_API_KEY overrides; status configured_unverified;
#           video billed per frame, 50-frame minimum per request)
# Selecting an unknown provider never produces observations.
VII_ENABLE_VISUAL_PERCEPTION=false
VII_VISUAL_PERCEPTION_PROVIDER=
VII_SAM_API_KEY=
VII_SAM_MODEL=
# AI-generation screening: hosted per-frame judgments (one billed call per
# sampled frame). Output is a probability with measured error rates, never
# a real/fake verdict. Off by default.
VII_ENABLE_AI_DETECTION=false
VII_AI_DETECTION_SAMPLES=5
# Spam-format screening (one hosted judgment per live video; on by default).
VII_ENABLE_SPAM_DETECTION=true
VII_API_HOST=127.0.0.1
VII_API_PORT=8765

# --- Auth & consumers (required for any non-loopback bind) ---
# VII_REQUIRE_AUTH=true demands VII_API_KEYS and/or VII_CONSUMER_KEYS.
# Unauthenticated mode is loopback-only by design (see docs/SECURITY.md).
VII_REQUIRE_AUTH=false
VII_API_KEYS=
VII_CONSUMER_KEYS=
VII_CONSUMER_ID=default

# --- Platform APIs (optional, authorized access only) ---
VII_INSTAGRAM_TOKEN=
VII_FACEBOOK_PAGE_TOKEN=

# --- Jobs, storage, webhooks (optional) ---
VII_WORKER_CONCURRENCY=2
VII_STORAGE_BACKEND=local
VII_S3_BUCKET=
VII_S3_ENDPOINT=
VII_WEBHOOK_ENABLED=false
VII_WEBHOOK_SECRET=

# --- Dataset (optional; app runs normally when absent) ---
# Canonical default: data/dataset.csv — see docs/DATASET.md.
DATASET_CSV_PATH=data/dataset.csv
